# Staging — menyajikan dist-staging/ pada port 4174.
#
# Pemasangan:
#   sudo cp deploy/hydro-telemetry-frontend-staging.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hydro-telemetry-frontend-staging

[Unit]
Description=Hydro Telemetry Svelte Frontend (staging)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=telemetring
WorkingDirectory=/var/www/frontend-telemetering/hydro-telemetry-svelte

# Alamat backend sudah ter-bundle saat build, jadi yang membedakan staging dari
# production adalah direktori outputnya — dan di sini direktori itu disebut
# eksplisit, bukan disimpulkan dari build terakhir.
#
# `--api` meneruskan /api/* dan WebSocket monitoring ke backend staging di mesin
# yang sama. Pasangannya VITE_API_BASE_URL=/ di .env.staging. Dengan URL absolut,
# browser pengguna menghubungi backend sendiri, dan IP Tailscale backend tidak
# dapat dijangkau dari WiFi kantor.
#
# Setelah mengubah berkas ini, salin ulang ke /etc/systemd/system/ lalu
# `sudo systemctl daemon-reload` — deploy.sh hanya me-restart service.
ExecStart=/home/telemetring/.bun/bin/bun deploy/static-server.ts --dir dist-staging --port 4174 --api http://127.0.0.1:18000

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/frontend-telemetering/hydro-telemetry-svelte

[Install]
WantedBy=multi-user.target
