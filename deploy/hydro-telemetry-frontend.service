# Production — menyajikan dist/ pada port 4173.
#
# Pemasangan:
#   sudo cp deploy/hydro-telemetry-frontend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hydro-telemetry-frontend

[Unit]
Description=Hydro Telemetry Svelte Frontend (production)
# network-online lebih tepat daripada network.target: yang terakhir hanya
# menandakan stack jaringan sudah dikonfigurasi, belum tentu bisa bind alamat.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=telemetring
WorkingDirectory=/var/www/frontend-telemetering/hydro-telemetry-svelte

# Direktori disebut eksplisit. Berbeda dari versi React, SvelteKit tidak
# menyediakan `vite preview --outDir`; tanpa server sendiri, service ini bisa
# menyajikan bundle staging tanpa satu pun pesan error.
ExecStart=/home/telemetring/.bun/bin/bun deploy/static-server.ts --dir dist --port 4173

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/frontend-telemetering/hydro-telemetry-svelte

[Install]
WantedBy=multi-user.target
