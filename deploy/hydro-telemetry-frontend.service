# Production — menyajikan dist/ pada port 4173.
#
# Pemasangan:
#   sudo cp deploy/hydro-telemetry-frontend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hydro-telemetry-frontend

[Unit]
Description=Hydro Telemetry Svelte Frontend (production)
# network-online lebih tepat daripada network.target: yang terakhir hanya
# menandakan stack jaringan sudah dikonfigurasi, belum tentu bisa bind alamat.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=telemetring
WorkingDirectory=/var/www/frontend-telemetering/hydro-telemetry-svelte

# Direktori disebut eksplisit. Berbeda dari versi React, SvelteKit tidak
# menyediakan `vite preview --outDir`; tanpa server sendiri, service ini bisa
# menyajikan bundle staging tanpa satu pun pesan error.
#
# `--api` meneruskan /api/* dan WebSocket monitoring ke backend production di
# mesin yang sama. Pasangannya VITE_API_BASE_URL=/ di .env.production. Dengan URL
# absolut, browser pengguna menghubungi backend sendiri, dan IP Tailscale backend
# tidak dapat dijangkau dari WiFi kantor.
#
# Setelah mengubah berkas ini, salin ulang ke /etc/systemd/system/ lalu
# `sudo systemctl daemon-reload` — deploy.sh hanya me-restart service.
ExecStart=/home/telemetring/.bun/bin/bun deploy/static-server.ts --dir dist --port 4173 --api http://127.0.0.1:8000

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/frontend-telemetering/hydro-telemetry-svelte

[Install]
WantedBy=multi-user.target
